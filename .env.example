# Required for Phase 4 RAG Chatbot
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: For Claude Vision LLM as alternative to ViT
ANTHROPIC_API_KEY=

# Optional: For OpenAI fallback in RAG
OPENAI_API_KEY=

# Backend CORS — comma-separated origins, or * for all
CORS_ORIGINS=*

# Frontend API URL (used by Expo via EXPO_PUBLIC_ prefix)
# Set this in your environment or .env file
EXPO_PUBLIC_API_URL=http://localhost:8000
